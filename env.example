# ==============================================================================
# Braid — Environment Configuration Reference (env.example)
# ==============================================================================
# Copy this file to `.env.local` for local development or configure these variables
# in your deployment platform (Vercel, Railway, Render, Fly.io, AWS, Neon, Supabase).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
# Defines the operational mode ('development' | 'production' | 'test').
# In production, security features (secure cookies, origin validation, SSL) are enforced.
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# In Development: If DATABASE_URL is unset, Braid automatically uses embedded
# SQLite file storage at `.data/braid.db`.
# Set BRAID_DB_MEMORY=true if you want ephemeral in-memory SQLite (used during tests).
# BRAID_DB_MEMORY=false

# In Production: PostgreSQL connection string is REQUIRED.
# Supports Neon, Supabase, AWS RDS, Railway, Render, etc.
# Examples:
# DATABASE_URL=postgresql://username:password@hostname:5432/braid?sslmode=require
# DATABASE_URL=postgres://user:password@ep-cool-forest.us-east-1.aws.neon.tech/braid?sslmode=require
DATABASE_URL=

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY SECRETS
# ------------------------------------------------------------------------------
# Secret key used to sign and verify HMAC SHA-256 handshake tokens between
# the Next.js web application and the WebSocket synchronization server.
# Recommended: generate a strong 32+ character random string (e.g., `openssl rand -hex 32`).
# If omitted, Braid securely derives a deterministic token from DATABASE_URL.
AUTH_SECRET=your-32-plus-character-secret-key-here
# SESSION_SECRET is also supported as an alias
# SESSION_SECRET=your-32-plus-character-secret-key-here

# ------------------------------------------------------------------------------
# 4. WEBSOCKET SYNC SERVER (STANDALONE PROCESS)
# ------------------------------------------------------------------------------
# Port for the WebSocket real-time CRDT sync server (`npm run sync-server`).
PORT=4444

# ------------------------------------------------------------------------------
# 5. CLIENT-FACING WEBSOCKET ENDPOINT (NEXT_PUBLIC_*)
# ------------------------------------------------------------------------------
# Public URL consumed by browser clients in the editor to connect to the sync server.
# In Development: ws://localhost:4444
# In Production: Must use secure wss:// scheme pointing to your hosted sync server.
# Examples:
# NEXT_PUBLIC_WS_URL=wss://sync.yourdomain.com
# NEXT_PUBLIC_WS_URL=wss://braid-sync.up.railway.app
NEXT_PUBLIC_WS_URL=ws://localhost:4444

# ------------------------------------------------------------------------------
# 6. CROSS-ORIGIN RESOURCE SHARING & WEBSOCKET ORIGINS
# ------------------------------------------------------------------------------
# Comma-separated list of allowed web frontend origins for cross-origin WebSocket
# connections to the SyncServer in production.
# Required when Next.js frontend (e.g. Vercel) is hosted separately from the sync server.
# Example:
# ALLOWED_ORIGINS=https://braid.yourdomain.com,https://braid-app.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
